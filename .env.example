# Copie ce fichier en « .env » (jamais publié). Chez l'hébergeur, ces noms se saisissent
# dans le panneau « Environment variables » : le fichier .env n'est alors pas nécessaire.
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=comptoir
# Base hébergée dans le cloud : en général DB_SSL=1 (connexion chiffrée)
DB_SSL=0
# Sites autorisés à appeler l'API depuis un navigateur. Inutile en production (même adresse).
ORIGINES=http://localhost:5173
# Au moins 32 caractères aléatoires :  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=remplace-moi-par-une-longue-valeur-aleatoire-de-48-octets
BCRYPT_COUT=12
ADMIN_EMAIL=admin@comptoir.example
ADMIN_MOT_DE_PASSE=change-ce-mot-de-passe-12
# Derrière un hébergeur (proxy) : 1. En local : 0.
TRUST_PROXY=0
