{
  "name": "comptoir-fullstack",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "npm ci --prefix client --include=dev && npm run build --prefix client",
    "start": "node --env-file-if-exists=.env serveur/src/server.js",
    "dev": "node --env-file-if-exists=.env --watch serveur/src/server.js",
    "db:init": "node --env-file-if-exists=.env serveur/src/initialiser.js",
    "admin:creer": "node --env-file-if-exists=.env serveur/src/creer_admin.js",
    "test": "node --test"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.6",
    "zod": "^4.6.7"
  }
}
